# ==============================================================================
# SpotQ Infrastructure - Local & Staging Environment Variables Template
# ==============================================================================
# When running locally with Infisical, variables are automatically injected:
#   infisical run --env=dev -- docker compose up
#
# Alternatively, you can copy this file to .env for manual local override:
#   cp .env.example .env
# ==============================================================================

# ─── Infisical Service Tokens ─────────────────────────────────────────────────
# Tokens used by each microservice to fetch their runtime secrets from Infisical.
USER_INFISICAL_TOKEN=
RESTAURANT_INFISICAL_TOKEN=
ORDER_INFISICAL_TOKEN=
PAYMENT_INFISICAL_TOKEN=
QUEUE_INFISICAL_TOKEN=
ETA_INFISICAL_TOKEN=

# ─── Message Broker (RabbitMQ) ────────────────────────────────────────────────
# Default credentials for RabbitMQ AMQP and Management Dashboard (port 15672)
RABBITMQ_DEFAULT_USER=spotq_admin
RABBITMQ_DEFAULT_PASS=spotq_secret_pass

# ─── Observability Stack (Grafana) ───────────────────────────────────────────
# Administrator credentials for Grafana Dashboard (port 3006)
# Enabled when launching with the monitoring profile:
#   infisical run --env=dev -- docker compose --profile monitoring up
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin_secure_password

