          "legendFormat": "{{job}} Resident Memory",
          "refId": "A"
        }
      ],
      "title": "Observability Stack Resident Memory",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
